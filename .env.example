# CapstoneTrack Environment Configuration

# Database Connection (Supabase Postgres or fallback SQLite)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./capstonetrack.db

# JWT Security
JWT_SECRET=super-secret-capstonetrack-jwt-token-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Configuration
PORT=8000
HOST=0.0.0.0
